        "ASPNETCORE_ENVIRONMENT": "Development",
        "Db__Provider": "SqlServer",
        "ConnectionStrings__DefaultConnection": "Server=localhost,14330;Database=app_database;User Id=sa;TrustServerCertificate=True",
        "Db__PasswordFile": "../../../infra/docker/secrets/mssql_sa_password.txt"
